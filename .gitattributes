# Force LF regardless of a contributor's or CI runner's core.autocrlf.
#
# schema/*.schema.json is generated by `xtask` and compared byte-for-byte
# against a freshly regenerated copy (see .github/workflows/ci.yml's
# "Check JSON Schema is up to date" step). `xtask`'s generator always
# writes LF; without this file, a Windows checkout with the common
# core.autocrlf=true default rewrites every LF to CRLF on checkout,
# making every line of every generated schema compare unequal to what
# `xtask check` regenerates in memory — a false "drift" that has nothing
# to do with the schema's actual content.
*.json text eol=lf
